@page "/"
@implements IDisposable
@inject ISpeechService SpeechService
@inject IJSRuntime JS
@inject DBRepository _repository
@inject SharingService SharingService
@using Microsoft.Maui.ApplicationModel
@using VoiceRecognition.Abstractions
@using VoiceRecognition.DBContext.Models
@using VoiceRecognition.DBContext.Repositories
@using VoiceRecognition.Services
@namespace VoiceRecognition.Components.Pages

<div class="assistant-wrapper">
    <div class="assistant-container @(SpeechService.IsListening ? "active" : "")">
        <h3>Voice Recognition</h3>
        <div class="status">@status</div>

        <button class="mic-button @(SpeechService.IsListening ? "listening" : "")"
                @onclick="ToggleListening">
            <span>@(SpeechService.IsListening ? "🛑" : "🎤")</span>
        </button>

        <div class="waveform">
            @foreach (var height in BarHeights)
            {
                <div class="bar" style="height:@(height)px"></div>
            }
        </div>

        <!-- Отображение распознанного текста -->
        @if (!string.IsNullOrEmpty(recognizedText))
        {
            <div class="recognized-text">
                @recognizedText
            </div>
        }

        <!-- Кнопки управления историей -->
        <div class="history-controls">
            <button class="btn-history" @onclick="ShowHistory">
                📋 История (@recordCount)
            </button>
        </div>
    </div>
</div>

<!-- Оверлей протокола -->
@if (showProtocolOverlay)
{
    <div class="protocol-overlay">
        <img src="images/tony.jpg" alt="Jarvis Activation" />
        <div class="protocol-text">Protocol Activated</div>
    </div>
}

<!-- Модальное окно истории -->
@if (showHistoryModal)
{
    <div class="modal-overlay" @onclick="CloseHistory">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h4>История запросов</h4>
                <button class="btn-close" @onclick="CloseHistory">✕</button>
            </div>

            <div class="search-box">
                <input type="text" @bind="searchText" @oninput="OnSearchTextChanged"
                       placeholder="Поиск в истории..." />
            </div>

            <div class="history-list">
                @if (filteredRecords.Any())
                {
                    @foreach (var record in filteredRecords)
                    {
                        <div class="history-item @(record.IsFavorite ? "favorite" : "")">
                            <div class="record-text">@record.Text</div>
                            <div class="record-meta">
                                <span class="record-date">@record.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                <div class="record-actions">
                                    <button class="btn-favorite"
                                            @onclick="() => ToggleFavorite(record)"
                                            title="@(record.IsFavorite ? "Убрать из избранного" : "В избранное")">
                                        @if (record.IsFavorite)
                                        {
                                            <span>⭐</span>
                                        }
                                        else
                                        {
                                            <span>☆</span>
                                        }
                                    </button>
                                    <button class="btn-share"
                                            @onclick="() => ShareRecord(record)"
                                            title="Поделиться">
                                        📤
                                    </button>
                                    <button class="btn-delete"
                                            @onclick="() => DeleteRecord(record)"
                                            title="Удалить">
                                        🗑️
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-history">
                        @if (string.IsNullOrEmpty(searchText))
                        {
                            <p>История запросов пуста</p>
                        }
                        else
                        {
                            <p>Ничего не найдено</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<audio id="activateAudio" src="sounds/fart-with-reverb.mp3" preload="auto"></audio>
<script src="js/site.js"></script>

@code {
    string recognizedText = "";
    string status = "Скажи что-нибудь…";
    bool showProtocolOverlay = false;
    bool showHistoryModal = false;
    string searchText = "";
    int[] BarHeights = new int[5];

    // Данные для истории
    int recordCount = 0;
    List<RequestModel> allRecords = new();
    List<RequestModel> filteredRecords = new();

    // Флаг для отслеживания подписок
    private bool _areEventsSubscribed = false;

    protected override async Task OnInitializedAsync()
    {
        await SubscribeToEvents();
        await LoadRecords();
    }

    private async Task SubscribeToEvents()
    {
        if (!_areEventsSubscribed)
        {
            SpeechService.PartialResult += OnPartialResult;
            SpeechService.FinalResult += OnFinalResult;
            SpeechService.VolumeChanged += OnVolumeChanged;
            _areEventsSubscribed = true;

            // Логирование для отладки
            System.Diagnostics.Debug.WriteLine("✅ События подписаны");
        }
    }

    private void UnsubscribeFromEvents()
    {
        if (_areEventsSubscribed)
        {
            SpeechService.PartialResult -= OnPartialResult;
            SpeechService.FinalResult -= OnFinalResult;
            SpeechService.VolumeChanged -= OnVolumeChanged;
            _areEventsSubscribed = false;

            // Логирование для отладки
            System.Diagnostics.Debug.WriteLine("✅ События отписаны");
        }
    }

    private void OnPartialResult(string text)
    {
        recognizedText = text;
        InvokeAsync(StateHasChanged);
    }

    private async void OnFinalResult(string text)
    {
        recognizedText = text;
        status = "Готово";
        await InvokeAsync(StateHasChanged);
        await SearchInBrowser();
    }

    private void OnVolumeChanged(float volume)
    {
        for (int i = 0; i < BarHeights.Length; i++)
            BarHeights[i] = 10 + (int)(volume * 5 * (i + 1) / BarHeights.Length);
        InvokeAsync(StateHasChanged);
    }

    async Task LoadRecords()
    {
        try
        {
            allRecords = await _repository.GetAllRecordsAsync();
            recordCount = allRecords.Count;
            FilterRecords();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"❌ Ошибка загрузки записей: {ex.Message}");
        }
    }

    void FilterRecords()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredRecords = allRecords;
        }
        else
        {
            filteredRecords = allRecords
                .Where(r => r.Text.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    void OnSearchTextChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        FilterRecords();
        StateHasChanged();
    }

    async Task ToggleListening()
    {
        if (!SpeechService.IsListening)
        {
            status = "Слушаю…";
            recognizedText = "";
            await SpeechService.StartListeningAsync();
        }
        else
        {
            await SpeechService.StopListeningAsync();
            status = "Останавливаю…";
            await SearchInBrowser();
            status = "Скажи что-нибудь…";
        }
        StateHasChanged();
    }

    async Task SearchInBrowser()
    {
        if (string.IsNullOrWhiteSpace(recognizedText)) return;

        if (recognizedText.Contains("Джарвис") && recognizedText.Contains("активировать") && recognizedText.Contains("протокол"))
        {
            await ActivateProtocolEffect();
        }
        else
        {

            var q = Uri.EscapeDataString(recognizedText);
            var url = $"https://www.google.com/search?q={q}";
            await SaveRecordToDatabase(url);
            await Launcher.OpenAsync(new Uri(url));
        }
    }

    async Task SaveRecordToDatabase(string request)
    {
        if (!string.IsNullOrWhiteSpace(request))
        {
            try
            {
                var record = new RequestModel
                {
                    Text = request,
                    CreatedAt = DateTime.Now,
                    IsFavorite = false
                };

                await _repository.SaveRecordAsync(record);
                await LoadRecords();

                System.Diagnostics.Debug.WriteLine($"✅ Запись сохранена: {recognizedText}");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"❌ Ошибка сохранения: {ex.Message}");
            }
        }
    }

    async Task ActivateProtocolEffect()
    {
        showProtocolOverlay = true;
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("playActivationSound");
        await Task.Delay(3000);
        showProtocolOverlay = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task ShowHistory()
    {
        await LoadRecords();
        showHistoryModal = true;
        StateHasChanged();
    }

    void CloseHistory()
    {
        showHistoryModal = false;
        searchText = "";
        FilterRecords();
        StateHasChanged();
    }

    async Task ShareRecord(RequestModel record)
    {
        await SharingService.ShareTextAsync(record.Text, "Поделиться записью");
    }

    async Task ToggleFavorite(RequestModel record)
    {
        await _repository.ToggleFavoriteAsync(record.Id);
        await LoadRecords();
    }

    async Task DeleteRecord(RequestModel record)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Удалить эту запись?");
        if (confirm)
        {
            await _repository.DeleteRecordAsync(record);
            await LoadRecords();
        }
    }

    public void Dispose()
    {
        UnsubscribeFromEvents();

        // Логирование для отладки
        System.Diagnostics.Debug.WriteLine("🔴 Компонент удален");
    }
}